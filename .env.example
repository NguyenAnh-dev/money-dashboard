# Copy this file to `.env` and fill in your real values.
#
#   Windows:  copy .env.example .env
#
# `.env` is gitignored and never gets committed. THIS file (.env.example)
# IS committed, so other people know what config the project needs.
# This is standard practice on every real engineering team.
#
# VALUES HERE ARE EMPTY ON PURPOSE. A placeholder like "your_key_here" is
# indistinguishable from a real value to code that only checks whether the
# variable is set -- so the adapter would sail past the check and fail deep
# inside an API call with a 400. Empty means "absent", which is the state the
# conformance test skips on.

# ---- Plaid (Step 4) ----
# Get these free at https://dashboard.plaid.com/signup -> Team Settings > Keys.
# Keep PLAID_ENV as "sandbox" -- fake banks, fake data, no real money.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Obtained ONCE by running scripts/get_plaid_token.py, then pasted here.
# Access tokens do not expire, which is why this is config rather than
# something the adapter fetches on every run. It is a credential: it grants
# read access to the linked Item until you explicitly remove that Item.
PLAID_ACCESS_TOKEN=

# The Item the access token points at. NOT a secret, and required whenever
# DATA_SOURCE=plaid: without it the adapter resolves it via /item/get on every
# fetch, and since a new adapter is built per call that is two extra network
# round trips per render. scripts/get_plaid_token.py prints it beside the token.
PLAID_ITEM_ID=

# ---- App config ----
# Which adapter data_source.py builds: "fake", "csv", or "plaid".
# Defaults to fake when unset -- the default must never be the one that makes
# a network call.
DATA_SOURCE=fake

# Only read when DATA_SOURCE=csv. Relative paths resolve from the directory
# you run from, which is why tests/test_conformance.py pins this explicitly.
CSV_PATH=fixtures/bank_export.csv

# ---- The database (Step 5) ----
# Where money.db lives. Defaults to the project root when unset. A server
# started in the wrong directory CREATES an empty database and serves it.
DB_PATH=

# ---- The API (Step 6.2) ----
# Sets the Secure flag on the session cookie. OFF by default so that local
# http development works; a Secure cookie is never sent over http, so a
# default of on makes `uvicorn --reload` on localhost look like a broken
# login. MUST BE 1 IN ANY DEPLOYMENT -- see "Before this is deployed" in
# CLAUDE.md. Nothing in the app will remind you.
COOKIE_SECURE=0

# ---- Token encryption (Step 6.3) ----
# Fernet key for connections.access_token. REQUIRED before the API will
# start: a Plaid access token grants live read access to somebody's bank, so
# it is never stored in plaintext.
#
# Generate one with:
#   ./venv/Scripts/python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# 44 characters, url-safe base64. TREAT IT LIKE THE DATABASE ITSELF: lose it
# and every stored token is permanently unreadable, and every linked account
# has to be linked again. Rotating it means decrypting with the old key and
# re-encrypting with the new one -- there is no migration path for that yet.
ENCRYPTION_KEY=
